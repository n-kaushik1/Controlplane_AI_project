# Copy to .env and fill in real values. Never commit .env.

# --- Model provider -------------------------------------------------
# mock = deterministic offline provider (no keys needed)
MODEL_PROVIDER="openrouter"
MODEL_NAME="openrouter/free"
MODEL_BASE_URL="https://openrouter.ai/api/v1"
MODEL_TEMPERATURE="0.2"
MODEL_MAX_TOKENS="512"
MODEL_TIMEOUT_SECONDS="60"
MODEL_API_KEY=your_real_openrouter_key
TAVILY_API_KEY=your_real_tavily_key

# --- API hardening (all optional) -----------------------------------
# Require "X-API-Key: <value>" on POST /api/generate and review resolution.
# API_KEY=change-me
# Max requests per client IP per minute on those endpoints (0 = off).
# RATE_LIMIT_PER_MINUTE=30
# Max prompt length in characters.
# MAX_PROMPT_CHARS=8000
# Extra CORS origins (comma-separated). The dashboard is same-origin.
# CORS_ORIGINS=http://localhost:5500
# LOG_LEVEL=INFO
